generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                      String                   @id @default(cuid())
  participantCode         String?                  @unique @map("participant_code")
  condition               String?
  startedAt               DateTime                 @default(now()) @map("started_at")
  dialogueStartedAt       DateTime?                @map("dialogue_started_at")
  endedAt                 DateTime?                @map("ended_at")
  sessionAccessTokenHash  String?                  @unique @map("session_access_token_hash")
  currentTopicId          String?                  @map("current_topic_id")
  currentTopicIndex       Int?                     @map("current_topic_index")
  topicStartedAt          DateTime?                @map("topic_started_at")
  conversationPhase       String?                  @map("conversation_phase")
  topicPausedMs           Int                      @default(0) @map("topic_paused_ms")
  protocolVersion         String?                  @map("protocol_version")
  appVersion              String?                  @map("app_version")
  aiPolicyVersion         String?                  @map("ai_policy_version")
  finalMinutes            FinalMinute[]
  aiInterventionLogs      AIInterventionLog[]
  aiActionEvents          AIActionEvent[]
  aiProcessingState       AIProcessingState?
  aiSpeechState           AISpeechState?
  slotProcessingStates    SlotProcessingState[]
  remoteMicActiveSessions RemoteMicActiveSession[]
  subSlotStates           SlotSubState[]
  slotStates              SlotState[]
  utterances              SessionUtterance[]

  @@index([startedAt])
  @@index([dialogueStartedAt])
  @@index([currentTopicId])
  @@map("sessions")
}

model SessionUtterance {
  id                     String    @id @default(cuid())
  participantCode        String?   @map("participant_code")
  sessionId              String    @map("session_id")
  speaker                String
  text                   String
  startMs                Int?      @map("start_ms")
  endMs                  Int?      @map("end_ms")
  source                 String?
  topicId                String?   @map("topic_id")
  topicIndex             Int?      @map("topic_index")
  sourceGroupId          String?   @map("source_group_id")
  asrProvider            String?   @map("asr_provider")
  asrModel               String?   @map("asr_model")
  remoteStreamId         String?   @map("remote_stream_id")
  remoteTranscriptId     String?   @map("remote_transcript_id")
  captureEpoch           Int?      @map("capture_epoch")
  capturedDuringAiSpeech Boolean?  @map("captured_during_ai_speech")
  aiPlaybackIdAtCapture  String?   @map("ai_playback_id_at_capture")
  firstPartialAt         DateTime? @map("first_partial_at")
  finalizedAt            DateTime? @map("finalized_at")
  analysisVersion        String?   @map("analysis_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")
  session                Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, speaker, remoteStreamId, remoteTranscriptId])
  @@index([sessionId])
  @@index([participantCode])
  @@index([speaker])
  @@index([sessionId, topicId])
  @@index([sourceGroupId])
  @@index([remoteTranscriptId])
  @@index([remoteStreamId])
  @@index([createdAt])
  @@index([sessionId, startMs])
  @@map("utterances")
}

model SlotState {
  id                String   @id @default(cuid())
  participantCode   String?  @map("participant_code")
  sessionId         String   @map("session_id")
  slotName          String   @map("slot_name")
  status            String
  summary           String
  evidenceUtterance String?  @map("evidence_utterance")
  updatedAt         DateTime @updatedAt @map("updated_at")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, slotName])
  @@index([sessionId])
  @@index([participantCode])
  @@index([status])
  @@map("slot_states")
}

model SlotSubState {
  id                   String   @id @default(cuid())
  participantCode      String?  @map("participant_code")
  sessionId            String   @map("session_id")
  mainSlotId           String   @map("main_slot_id")
  subSlotId            String   @map("sub_slot_id")
  completion           String
  responseState        String   @map("response_state")
  reasonCode           String?  @map("reason_code")
  evidenceUtteranceIds Json     @map("evidence_utterance_ids")
  canAskAgain          Boolean  @default(true) @map("can_ask_again")
  isDeferred           Boolean  @default(false) @map("is_deferred")
  lastUpdatedTopicId   String?  @map("last_updated_topic_id")
  updatedAt            DateTime @updatedAt @map("updated_at")
  depth                String?
  session              Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, mainSlotId, subSlotId])
  @@index([sessionId])
  @@index([participantCode])
  @@index([mainSlotId])
  @@index([subSlotId])
  @@index([completion])
  @@index([responseState])
  @@index([reasonCode])
  @@map("slot_sub_states")
}

model FinalMinute {
  id              String   @id @default(cuid())
  participantCode String?  @map("participant_code")
  sessionId       String   @map("session_id")
  markdown        String
  json            Json
  createdAt       DateTime @default(now()) @map("created_at")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([participantCode])
  @@index([createdAt])
  @@map("final_minutes")
}

model AIInterventionLog {
  id              String    @id @default(cuid())
  participantCode String?   @map("participant_code")
  sessionId       String    @map("session_id")
  type            String
  content         String
  topicId         String?   @map("topic_id")
  requestedAt     DateTime? @map("requested_at")
  generatedAt     DateTime  @map("generated_at")
  displayedAt     DateTime? @map("displayed_at")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, generatedAt])
  @@index([sessionId, type])
  @@index([participantCode])
  @@index([topicId])
  @@index([createdAt])
  @@map("ai_intervention_logs")
}

model AIActionEvent {
  id                String   @id
  participantCode   String?  @map("participant_code")
  sessionId         String   @map("session_id")
  actionType        String   @map("action_type")
  currentTopicId    String?  @map("current_topic_id")
  currentTopicTitle String?  @map("current_topic_title")
  targetMainSlotId  String?  @map("target_main_slot_id")
  targetSubSlotId   String?  @map("target_sub_slot_id")
  generatedText     String?  @map("generated_text")
  reason            String?
  result            String?
  model             String?
  policyVersion     String?  @map("policy_version")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([participantCode])
  @@index([actionType])
  @@index([currentTopicId])
  @@index([createdAt])
  @@map("ai_action_events")
}

model AIProcessingState {
  id                       String    @id @default(cuid())
  participantCode          String?   @map("participant_code")
  sessionId                String    @unique @map("session_id")
  lastProcessedUtteranceId String?   @map("last_processed_utterance_id")
  lastProcessedAt          DateTime? @map("last_processed_at")
  slotRevision             Int       @default(0) @map("slot_revision")
  processingStatus         String    @default("idle") @map("processing_status")
  processingStartedAt      DateTime? @map("processing_started_at")
  processingFinishedAt     DateTime? @map("processing_finished_at")
  lastError                String?   @map("last_error")
  retryCount               Int       @default(0) @map("retry_count")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  session                  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([participantCode])
  @@index([processingStatus])
  @@index([updatedAt])
  @@map("ai_processing_states")
}

model SlotProcessingState {
  id                              String    @id @default(cuid())
  participantCode                 String?   @map("participant_code")
  sessionId                       String    @map("session_id")
  topicId                         String    @map("topic_id")
  lastProcessedUtteranceId        String?   @map("last_processed_utterance_id")
  lastProcessedAt                 DateTime? @map("last_processed_at")
  processingRangeEndUtteranceId   String?   @map("processing_range_end_utterance_id")
  processingRangeStartedAt        DateTime? @map("processing_range_started_at")
  slotRevision                    Int       @default(0) @map("slot_revision")
  processingStatus                String    @default("idle") @map("processing_status")
  processingStartedAt             DateTime? @map("processing_started_at")
  processingFinishedAt            DateTime? @map("processing_finished_at")
  lastError                       String?   @map("last_error")
  retryCount                      Int       @default(0) @map("retry_count")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")
  session                         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, topicId])
  @@index([sessionId])
  @@index([participantCode])
  @@index([topicId])
  @@index([processingStatus])
  @@index([updatedAt])
  @@map("slot_processing_states")
}

model AISpeechState {
  id              String    @id @default(cuid())
  participantCode String?   @map("participant_code")
  sessionId       String    @unique @map("session_id")
  active          Boolean   @default(false)
  playbackId      String?   @map("playback_id")
  contentType     String?   @map("content_type")
  revision        Int       @default(0)
  startedAt       DateTime? @map("started_at")
  expectedEndAt   DateTime? @map("expected_end_at")
  endedAt         DateTime? @map("ended_at")
  releaseAfter    DateTime? @map("release_after")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([participantCode])
  @@index([active])
  @@index([updatedAt])
  @@map("ai_speech_states")
}

model RemoteMicActiveSession {
  id          String   @id @default(cuid())
  channel     String   @unique
  sessionId   String   @map("session_id")
  activatedAt DateTime @default(now()) @map("activated_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([updatedAt])
  @@map("remote_mic_active_sessions")
}
