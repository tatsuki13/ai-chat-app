generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id                 String               @id @default(cuid())
  participantCode    String?              @map("participant_code")
  condition          String?
  startedAt          DateTime             @default(now()) @map("started_at")
  dialogueStartedAt  DateTime?            @map("dialogue_started_at")
  endedAt            DateTime?            @map("ended_at")
  finalMinutes       FinalMinute[]
  aiInterventionLogs AIInterventionLog[]
  aiActionEvents     AIActionEvent[]
  subSlotStates      SlotSubState[]
  slotStates         SlotState[]
  utterances         SessionUtterance[]
  remoteMicTokens    RemoteMicJoinToken[]
  webRtcSignals      WebRtcSignal[]

  @@index([startedAt])
  @@index([dialogueStartedAt])
  @@index([participantCode])
  @@map("sessions")
}

model RemoteMicJoinToken {
  id              String                @id @default(cuid())
  tokenHash       String                @unique @map("token_hash")
  sessionId       String                @map("session_id")
  participantCode String?               @map("participant_code")
  role            String
  expiresAt       DateTime              @map("expires_at")
  usedAt          DateTime?             @map("used_at")
  revokedAt       DateTime?             @map("revoked_at")
  lastHeartbeatAt DateTime?             @map("last_heartbeat_at")
  disconnectedAt  DateTime?             @map("disconnected_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  chunks          RemoteMicAudioChunk[]
  session         Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, role, revokedAt, expiresAt])
  @@index([participantCode])
  @@index([expiresAt])
  @@map("remote_mic_join_tokens")
}

model RemoteMicAudioChunk {
  id               String             @id @default(cuid())
  remoteMicTokenId String             @map("remote_mic_token_id")
  sessionId        String             @map("session_id")
  participantCode  String?            @map("participant_code")
  role             String
  clientChunkId    String             @map("client_chunk_id")
  sequence         Int
  capturedAt       DateTime           @map("captured_at")
  durationMs       Int                @map("duration_ms")
  averageLevel     Float?             @map("average_level")
  peakLevel        Float?             @map("peak_level")
  utteranceId      String?            @map("utterance_id")
  skipped          Boolean            @default(false)
  createdAt        DateTime           @default(now()) @map("created_at")
  remoteMicToken   RemoteMicJoinToken @relation(fields: [remoteMicTokenId], references: [id], onDelete: Cascade)

  @@unique([remoteMicTokenId, clientChunkId])
  @@index([sessionId, role, capturedAt])
  @@index([participantCode])
  @@index([createdAt])
  @@map("remote_mic_audio_chunks")
}

model SessionUtterance {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  participantCode String?  @map("participant_code")
  speaker         String
  text            String
  createdAt       DateTime @default(now()) @map("created_at")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([participantCode])
  @@index([speaker])
  @@index([createdAt])
  @@map("utterances")
}

model SlotState {
  id                String   @id @default(cuid())
  sessionId         String   @map("session_id")
  participantCode   String?  @map("participant_code")
  slotName          String   @map("slot_name")
  status            String
  summary           String
  evidenceUtterance String?  @map("evidence_utterance")
  updatedAt         DateTime @updatedAt @map("updated_at")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, slotName])
  @@index([sessionId])
  @@index([participantCode])
  @@index([status])
  @@map("slot_states")
}

model SlotSubState {
  id                   String   @id @default(cuid())
  sessionId            String   @map("session_id")
  participantCode      String?  @map("participant_code")
  mainSlotId           String   @map("main_slot_id")
  subSlotId            String   @map("sub_slot_id")
  completion           String
  responseState        String   @map("response_state")
  reasonCode           String?  @map("reason_code")
  evidenceUtteranceIds Json     @map("evidence_utterance_ids")
  canAskAgain          Boolean  @default(true) @map("can_ask_again")
  isDeferred           Boolean  @default(false) @map("is_deferred")
  lastUpdatedTopicId   String?  @map("last_updated_topic_id")
  updatedAt            DateTime @updatedAt @map("updated_at")
  session              Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, mainSlotId, subSlotId])
  @@index([sessionId])
  @@index([participantCode])
  @@index([mainSlotId])
  @@index([subSlotId])
  @@index([completion])
  @@index([responseState])
  @@index([reasonCode])
  @@map("slot_sub_states")
}

model FinalMinute {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  participantCode String?  @map("participant_code")
  markdown        String
  json            Json
  createdAt       DateTime @default(now()) @map("created_at")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([participantCode])
  @@index([createdAt])
  @@map("final_minutes")
}

model AIInterventionLog {
  id              String    @id @default(cuid())
  sessionId       String    @map("session_id")
  participantCode String?   @map("participant_code")
  type            String
  content         String
  topicId         String?   @map("topic_id")
  requestedAt     DateTime? @map("requested_at")
  generatedAt     DateTime  @map("generated_at")
  displayedAt     DateTime? @map("displayed_at")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, generatedAt])
  @@index([sessionId, type])
  @@index([participantCode])
  @@index([topicId])
  @@index([createdAt])
  @@map("ai_intervention_logs")
}

model AIActionEvent {
  id                String   @id
  sessionId         String   @map("session_id")
  participantCode   String?  @map("participant_code")
  actionType        String   @map("action_type")
  currentTopicId    String?  @map("current_topic_id")
  currentTopicTitle String?  @map("current_topic_title")
  targetMainSlotId  String?  @map("target_main_slot_id")
  targetSubSlotId   String?  @map("target_sub_slot_id")
  generatedText     String?  @map("generated_text")
  reason            String?
  result            String?
  model             String?
  policyVersion     String?  @map("policy_version")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([participantCode])
  @@index([actionType])
  @@index([currentTopicId])
  @@index([createdAt])
  @@map("ai_action_events")
}

model WebRtcSignal {
  id              String   @id
  sessionId       String   @map("session_id")
  participantCode String?  @map("participant_code")
  role            String
  sender          String
  recipient       String
  messageType     String   @map("message_type")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, role, recipient, createdAt])
  @@index([participantCode])
  @@index([expiresAt])
  @@map("web_rtc_signals")
}
